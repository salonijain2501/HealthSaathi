# ==============================================================
# HealthSaathi Frontend - Environment Configuration
# ==============================================================

# Backend API URL
# Local development default: http://localhost:5000/api
# Production (Render): https://<your-service-name>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs -> Web application)
# Must match GOOGLE_CLIENT_ID configured on the backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
