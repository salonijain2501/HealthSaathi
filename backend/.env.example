# ==============================================================
# HealthSaathi Backend - Environment Configuration
# ==============================================================

# Server Port (Render automatically supplies PORT, default 5000 for local)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthsaathi?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret Key (Generate a cryptographically secure 256-bit random string)
# You can generate one via terminal: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Credentials)
# Must match the Client ID configured on Google Identity Services frontend
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Production Frontend URL (Cloudflare Pages or Custom Domain)
# Used for CORS whitelist validation
# Example: https://healthsaathi.pages.dev
FRONTEND_URL=http://localhost:5173

# AI Services (Optional / Feature specific)
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
